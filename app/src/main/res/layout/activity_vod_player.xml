<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/qp_page_bg"
    android:orientation="vertical">

    <com.qw.player.demo.widget.PlayerGestureLayout
        android:id="@+id/mPlayerContainer"
        android:layout_width="match_parent"
        android:layout_height="@dimen/player_bili_height"
        android:background="@android:color/black"
        android:keepScreenOn="true">

        <androidx.media3.ui.PlayerView
            android:id="@+id/mPlayerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/black"
            app:resize_mode="fit"
            app:show_buffering="never"
            app:use_controller="false" />

        <!-- 封面 + 居中播放按钮 -->
        <LinearLayout
            android:id="@+id/mCoverLayer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_vod_cover_overlay"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:id="@+id/mPlayBigBtn"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/bg_play_big_button"
                android:contentDescription="@string/vod_play_button"
                android:padding="20dp"
                android:src="@drawable/ic_player_play" />

            <TextView
                android:id="@+id/mCoverTitleLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.qw.player.demo.widget.VodPlayerControlView
            android:id="@+id/mPlayerControls"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.qw.player.demo.widget.PlayerGestureHints
            android:id="@+id/mGestureHints"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- 错误 / 缓冲覆盖层 -->
        <LinearLayout
            android:id="@+id/mErrorLayer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#B3000000"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/mErrorLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/mRetryBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_bili_follow"
                android:paddingStart="28dp"
                android:paddingTop="9dp"
                android:paddingEnd="28dp"
                android:paddingBottom="9dp"
                android:text="@string/vod_error_retry"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </com.qw.player.demo.widget.PlayerGestureLayout>

    <ScrollView
        android:id="@+id/mDetailContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/qp_page_bg"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="16dp"
            android:paddingEnd="18dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/mVodTitleLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/qp_text_primary"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/mVodAuthorLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/qp_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/vod_episodes"
                android:textColor="@color/qp_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/mEpisodeGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
