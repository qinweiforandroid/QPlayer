<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/mTopScrim"
        android:layout_width="match_parent"
        android:layout_height="112dp"
        android:background="@drawable/bg_player_top_scrim" />

    <View
        android:id="@+id/mBottomScrim"
        android:layout_width="match_parent"
        android:layout_height="132dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_player_bottom_scrim" />

    <LinearLayout
        android:id="@+id/mTopControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mBackBtn"
            style="@style/Widget.QPlayer.Button.PlayerIcon"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:contentDescription="@string/player_back"
            app:icon="@drawable/ic_player_back"
            app:iconSize="20dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/mChannelNameLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/mEpgLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mChannelListBtn"
            style="@style/Widget.QPlayer.Button.PlayerIcon"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:contentDescription="@string/live_channel_list"
            app:icon="@drawable/ic_player_list"
            app:iconSize="20dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/mBottomControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="14dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mPlayPauseBtn"
            style="@style/Widget.QPlayer.Button.PlayerIcon"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="@string/player_play"
            app:icon="@drawable/ic_player_play"
            app:iconSize="18dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mLineBtn"
            style="@style/Widget.QPlayer.Button.PlayerText"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="10dp"
            android:text="@string/live_line" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mVolumeBtn"
            style="@style/Widget.QPlayer.Button.PlayerIcon"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="@string/vod_mute"
            app:icon="@drawable/ic_player_volume"
            app:iconSize="18dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mBrightnessBtn"
            style="@style/Widget.QPlayer.Button.PlayerIcon"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@null"
            app:icon="@drawable/ic_player_brightness"
            app:iconSize="18dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mFullscreenBtn"
            style="@style/Widget.QPlayer.Button.PlayerIcon"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/player_fullscreen"
            app:icon="@drawable/ic_player_fullscreen"
            app:iconSize="18dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/mLinePanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="14dp"
        android:layout_marginBottom="58dp"
        android:background="@drawable/bg_player_panel"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone" />
</FrameLayout>
