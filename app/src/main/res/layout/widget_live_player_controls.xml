<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/mTopScrim"
        android:layout_width="match_parent"
        android:layout_height="112dp"
        android:background="@drawable/bg_player_top_scrim" />

    <View
        android:id="@+id/mBottomScrim"
        android:layout_width="match_parent"
        android:layout_height="132dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_player_bottom_scrim" />

    <LinearLayout
        android:id="@+id/mTopControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/mBackBtn"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_bili_control_button"
            android:contentDescription="@string/player_back"
            android:padding="9dp"
            android:src="@drawable/ic_player_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/mChannelNameLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/mEpgLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <ImageView
            android:id="@+id/mChannelListBtn"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_bili_control_button"
            android:contentDescription="@string/live_channel_list"
            android:padding="9dp"
            android:src="@drawable/ic_player_list" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/mBottomControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="14dp">

        <ImageView
            android:id="@+id/mPlayPauseBtn"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_bili_control_button"
            android:contentDescription="@string/player_play"
            android:padding="7dp"
            android:src="@drawable/ic_player_play" />

        <TextView
            android:id="@+id/mLineBtn"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_bili_control_button"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/live_line"
            android:textColor="@android:color/white"
            android:textSize="12sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/mVolumeBtn"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_bili_control_button"
            android:contentDescription="@string/vod_mute"
            android:padding="8dp"
            android:src="@drawable/ic_player_volume" />

        <ImageView
            android:id="@+id/mBrightnessBtn"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_bili_control_button"
            android:contentDescription="@null"
            android:padding="8dp"
            android:src="@drawable/ic_player_brightness" />

        <ImageView
            android:id="@+id/mFullscreenBtn"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_bili_control_button"
            android:contentDescription="@string/player_fullscreen"
            android:padding="8dp"
            android:src="@drawable/ic_player_fullscreen" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/mLinePanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="14dp"
        android:layout_marginBottom="58dp"
        android:background="@drawable/bg_player_panel"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone" />
</FrameLayout>
