<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/mTopScrim"
        android:layout_width="match_parent"
        android:layout_height="112dp"
        android:background="@drawable/bg_player_top_scrim" />

    <View
        android:id="@+id/mBottomScrim"
        android:layout_width="match_parent"
        android:layout_height="152dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_player_bottom_scrim" />

    <LinearLayout
        android:id="@+id/mTopControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mBackBtn"
            style="@style/Widget.QPlayer.Button.PlayerIcon"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:contentDescription="@string/player_back"
            app:icon="@drawable/ic_player_back"
            app:iconSize="20dp" />

        <TextView
            android:id="@+id/mTitleLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/vod_title"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mQualityBtn"
            style="@style/Widget.QPlayer.Button.PlayerText"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="@string/vod_quality" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mMoreBtn"
            style="@style/Widget.QPlayer.Button.PlayerIcon"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/vod_more"
            app:icon="@drawable/ic_player_more"
            app:iconSize="20dp" />
    </LinearLayout>

    <!-- 底部单行：播放暂停 / 进度条 / 时间 / 全屏 -->
    <LinearLayout
        android:id="@+id/mBottomControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mPlayPauseBtn"
            style="@style/Widget.QPlayer.Button.PlayerIcon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@string/player_play"
            app:icon="@drawable/ic_player_play"
            app:iconSize="18dp" />

        <SeekBar
            android:id="@+id/mSeekBar"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:max="1000"
            android:maxHeight="3dp"
            android:minHeight="3dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:progressDrawable="@drawable/player_seekbar_progress"
            android:splitTrack="false"
            android:thumb="@drawable/player_seekbar_thumb"
            android:thumbOffset="0dp" />

        <TextView
            android:id="@+id/mTimeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:minWidth="78dp"
            android:text="00:00/00:00"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mFullscreenBtn"
            style="@style/Widget.QPlayer.Button.PlayerIcon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:contentDescription="@string/player_fullscreen"
            app:icon="@drawable/ic_player_fullscreen"
            app:iconSize="18dp" />
    </LinearLayout>

    <!-- 清晰度面板 -->
    <LinearLayout
        android:id="@+id/mQualityPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="56dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_player_panel"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone" />

    <!-- 更多设置面板 -->
    <LinearLayout
        android:id="@+id/mMorePanel"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="56dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_player_panel"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vod_speed"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/mSpeedGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="10dp"
            android:background="#33FFFFFF" />

        <LinearLayout
            android:id="@+id/mMuteRow"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/mMuteIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/vod_mute"
                android:src="@drawable/ic_player_volume" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="@string/vod_mute"
                android:textColor="@android:color/white"
                android:textSize="14sp" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/mMuteSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/mLoopRow"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/vod_loop"
                android:src="@drawable/ic_player_loop" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="@string/vod_loop"
                android:textColor="@android:color/white"
                android:textSize="14sp" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/mLoopSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
