<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/mTopScrim"
        android:layout_width="match_parent"
        android:layout_height="112dp"
        android:background="@drawable/bg_player_top_scrim" />

    <View
        android:id="@+id/mBottomScrim"
        android:layout_width="match_parent"
        android:layout_height="152dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_player_bottom_scrim" />

    <LinearLayout
        android:id="@+id/mTopControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/mBackBtn"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_bili_control_button"
            android:contentDescription="@string/player_back"
            android:padding="9dp"
            android:src="@drawable/ic_player_back" />

        <TextView
            android:id="@+id/mTitleLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/vod_title"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/mQualityBtn"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_bili_control_button"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/vod_quality"
            android:textColor="@android:color/white"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/mMoreBtn"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_bili_control_button"
            android:contentDescription="@string/vod_more"
            android:padding="9dp"
            android:src="@drawable/ic_player_more" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/mBottomControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/mPlayPauseBtn"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_bili_control_button"
                android:contentDescription="@string/player_play"
                android:padding="7dp"
                android:src="@drawable/ic_player_play" />

            <TextView
                android:id="@+id/mTimeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="00:00 / 00:00"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/mFullscreenBtn"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_bili_control_button"
                android:contentDescription="@string/player_fullscreen"
                android:padding="8dp"
                android:src="@drawable/ic_player_fullscreen" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/mSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="1000"
            android:minHeight="20dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:progressTint="@color/bili_pink"
            android:thumbTint="@color/bili_pink" />
    </LinearLayout>

    <!-- 清晰度面板 -->
    <LinearLayout
        android:id="@+id/mQualityPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="56dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_player_panel"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone" />

    <!-- 更多设置面板 -->
    <LinearLayout
        android:id="@+id/mMorePanel"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="56dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_player_panel"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vod_speed"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/mSpeedGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="10dp"
            android:background="#33FFFFFF" />

        <LinearLayout
            android:id="@+id/mMuteRow"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/mMuteIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/vod_mute"
                android:src="@drawable/ic_player_volume" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="@string/vod_mute"
                android:textColor="@android:color/white"
                android:textSize="14sp" />

            <Switch
                android:id="@+id/mMuteSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/mLoopRow"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/vod_loop"
                android:src="@drawable/ic_player_loop" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="@string/vod_loop"
                android:textColor="@android:color/white"
                android:textSize="14sp" />

            <Switch
                android:id="@+id/mLoopSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
