<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 封面圆角：8dp / 20dp 两档，统一 ShapeableImageView 观感 -->
    <style name="ShapeAppearance.QPlayer.CoverSmall" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">10dp</item>
    </style>

    <style name="ShapeAppearance.QPlayer.CoverLarge" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <style name="ShapeAppearance.QPlayer.Pill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- 播放器沉浸层圆形图标按钮：覆盖默认 48dp 最小尺寸限制，由各处自行指定 layout_width/height -->
    <style name="Widget.QPlayer.Button.PlayerIcon" parent="Widget.Material3Expressive.Button.IconButton.Filled">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="iconPadding">0dp</item>
        <item name="backgroundTint">@color/qp_player_control_bg</item>
        <item name="iconTint">@android:color/white</item>
    </style>

    <!-- 播放器沉浸层文字按钮（线路/清晰度切换）：同一套暗色底 -->
    <style name="Widget.QPlayer.Button.PlayerText" parent="Widget.Material3Expressive.Button.TonalButton">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">32dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="backgroundTint">@color/qp_player_control_bg</item>
        <item name="cornerRadius">16dp</item>
    </style>

</resources>
